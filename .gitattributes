# Auto detect text files and checkout/commit as LF
* text=auto eol=lf

# C# source files
*.cs text eol=lf diff=csharp

# JSON files
*.json text eol=lf

# XML files
*.xml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Markdown files
*.md text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Docker files
Dockerfile text
docker-compose*.yml text

# Binary files
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text